# Application Mode: 'development' (shows errors locally) or 'production' (InfinityFree)
APP_ENV=development

# Database Configuration
DB_HOST=localhost
DB_NAME=ash-portfolio
DB_USER=root
DB_PASS=

# Base Path Override (Leave empty for auto-detection)
# Local XAMPP/WAMP usually auto-detects to /portfolio
# InfinityFree root htdocs auto-detects to /
SITE_BASE_PATH=

# Mail Configuration (PHPMailer - for contact form)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password_here
SMTP_SECURE=tls
MAIL_FROM_NAME="Ashraful Portfolio"