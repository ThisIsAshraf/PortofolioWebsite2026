# 1. Prevent Directory Browsing
Options -Indexes

# 2. Block direct browser access to sensitive system files & configurations
<IfModule mod_rewrite.c>
    RewriteEngine On

    # Prevent infinite loop when serving the custom error page itself
    RewriteRule ^403\.php$ - [L]

    # Intercept direct access to sensitive system files and route directly to 403.php
    RewriteRule ^(\.env|\.git|composer\.(json|lock)|config\.php|README\.md|tree\.php|setup\.php|\.htaccess)$ 403.php [L]

    # Block direct browser access to internal include folders
    RewriteRule ^(views|vendor|includes)/.*$ 403.php [L]

    # Block access to hidden dot-files (.git, .vscode, etc.)
    RewriteRule (^\.|/\.) - [F,L]

    # Standard clean routing for public portfolio
    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]

    RewriteRule ^ index.php [L,QSA]
</IfModule>